{
  "name": "@parkwise/web",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "docker:local": "bash scripts/docker-local.sh",
    "docker:local:host": "bash scripts/docker-local.sh --host-web",
    "docker:local:prod": "bash scripts/docker-local.sh --prod",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-assets.ts",
    "db:ib-backfill": "tsx scripts/ib-backfill.ts",
    "check:go-live": "tsx scripts/check-go-live.ts",
    "db:retention": "tsx scripts/retention.ts",
    "docs:encrypt": "tsx scripts/encrypt-documents.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "better-auth": "^1.6.23",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "^15.1.0",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "postcss": "^8.5.22",
    "sharp": "^0.35.3"
  }
}
