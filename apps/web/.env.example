DATABASE_URL=postgresql://parkwise:parkwise@localhost:5432/parkwise
DOCUMENTS_DIR=./.data/documents
# AES-256-GCM encryption at rest for the document vault (KYC). 32-byte key, hex or base64.
# Generate: openssl rand -hex 32
# Key unset + demo mode: uploads stored PLAINTEXT with a [storage:plaintext] warning.
# Key unset or malformed + DEMO_MODE=false: production startup fails validation.
# Already-encrypted files need this exact key to download — back it up like BETTER_AUTH_SECRET.
# On an existing vault, encrypt stored plaintext once with: npx tsx scripts/encrypt-documents.ts
# DOCUMENTS_ENCRYPTION_KEY=
DEMO_MODE=true
# Apply-first: Better Auth signup is closed unless ALLOW_BOOTSTRAP_SIGNUP=true (one-time first admin)
# ALLOW_BOOTSTRAP_SIGNUP=true
# SIGNUPS_DISABLED is legacy; ignore for apply-first
# Required only when DEMO_MODE=false — seed deletes interests/holdings for removed asset slugs
# CONFIRM_SEED=1
# Set true only when a funded buyback mechanism exists — otherwise buyback_at_par is rejected (CRO R3)
# BUYBACK_FUNDED=true
SUPER_ADMIN_EMAILS=ops@parkwise.eu
# ADMIN_EMAILS is deprecated — use SUPER_ADMIN_EMAILS (still accepted as fallback if SUPER_ADMIN_EMAILS is unset)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Sign-in / 2FA rate limits stay on unless this is false or 0 (Playwright CI).
# AUTH_RATE_LIMIT=false
# Comma-separated trusted proxy IPs for client-IP resolution (better-auth advanced.ipAddress.trustedProxies).
# Must be set when an upstream proxy/CDN sits in front of Traefik — otherwise session IPs resolve to the proxy's IP.
# Defaults to "127.0.0.1,::1" (Traefik on the same host).
# TRUSTED_PROXIES=127.0.0.1,::1
# Optional IP enrichment (see SETUP.md)
# IP_ENRICHMENT_API_URL=https://api.example.com/{ip}
# IP_ENRICHMENT_API_KEY=
# IP_ENRICHMENT_MMDB_PATH=
# Optional SMTP for transactional email (invites, interest updates, distributions).
# When SMTP_HOST is unset, sendTransactionalEmail skip-logs and returns sent:false.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Parkwise <noreply@example.com>
# Optional ops inbox notified on each new interest (delivered via SMTP when configured)
# OPS_INBOX_EMAIL=ops@parkwise.eu
# Four-eyes control: interests at/above this amount (integer euros) need two distinct
# super admin approvals before confirm→holding. Defaults to 50000 when unset/invalid.
# FOUR_EYES_THRESHOLD_EUR=50000
# CONTRACT_LEGAL_SIGNER_EMAIL=legal@parkwise.eu
# CONTRACT_LEGAL_SIGNER_NAME=Park legal signer
